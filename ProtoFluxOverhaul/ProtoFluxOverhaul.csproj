<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>ProtoFluxOverhaul</RootNamespace>
		<AssemblyName>ProtoFluxOverhaul</AssemblyName>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<TargetFramework>net10.0</TargetFramework>
		<FileAlignment>512</FileAlignment>
		<Nullable>disable</Nullable>
		<Deterministic>true</Deterministic>
		<!-- Change CopyToMods to true if you'd like builds to be moved into the Mods folder automatically-->
		<CopyToMods Condition="'$(CopyToMods)'==''">true</CopyToMods>
		<DebugType Condition="'$(Configuration)'=='Debug'">embedded</DebugType>

	</PropertyGroup>

	<PropertyGroup Condition="'$(ResonitePath)'==''">
		<!-- If you don't want to provide a ResonitePath in dotnet build, you can specify one here -->
		<ResonitePath>B:\SteamLibrary\steamapps\common\Resonite</ResonitePath>
		<!-- Fallback paths if the above doesn't exist -->
		<ResonitePath Condition="Exists('B:\SteamLibrary\steamapps\common\Resonite\')">B:\SteamLibrary\steamapps\common\Resonite\</ResonitePath>
	</PropertyGroup>

	<PropertyGroup>
		<ResoniteRoot>$([MSBuild]::EnsureTrailingSlash('$(ResonitePath)'))</ResoniteRoot>
		<!-- Compile against the official RML release, including when running through MonkeyLoader. -->
		<ResoniteModLoaderPath Condition="'$(ResoniteModLoaderPath)'==''">$(ResoniteRoot)Libraries\ResoniteModLoader.dll</ResoniteModLoaderPath>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="ResoniteModLoader">
		    <HintPath>$(ResoniteModLoaderPath)</HintPath>
		    <Private>False</Private>
		</Reference>
		<Reference Include="HarmonyLib">
		    <HintPath>$(ResoniteRoot)rml_libs\0Harmony.dll</HintPath>
		    <HintPath Condition="Exists('$(ResoniteRoot)0Harmony.dll')">$(ResoniteRoot)0Harmony.dll</HintPath>
		    <HintPath Condition="Exists('$(ResoniteRoot)rml_libs\0Harmony.dll')">$(ResoniteRoot)rml_libs\0Harmony.dll</HintPath>
		    <HintPath Condition="Exists('$(ResoniteRoot)Libraries\0Harmony.dll')">$(ResoniteRoot)Libraries\0Harmony.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="FrooxEngine">
		    <HintPath>$(ResoniteRoot)FrooxEngine.dll</HintPath>
		    <Private>False</Private>
		</Reference>
		<Reference Include="Elements.Core">
		    <HintPath>$(ResoniteRoot)Elements.Core.dll</HintPath>
		    <Private>False</Private>
		</Reference>
		<Reference Include="Awwdio">
		    <HintPath>$(ResoniteRoot)Awwdio.dll</HintPath>
		    <Private>False</Private>
		</Reference>
		<Reference Include="Elements.Assets">
		    <HintPath>$(ResoniteRoot)Elements.Assets.dll</HintPath>
		    <Private>False</Private>
		</Reference>
		<Reference Include="SkyFrost.Base.Models">
		    <HintPath>$(ResoniteRoot)SkyFrost.Base.Models.dll</HintPath>
		    <Private>False</Private>
		</Reference>
		<Reference Include="ProtoFlux.Core">
		    <HintPath>$(ResoniteRoot)ProtoFlux.Core.dll</HintPath>
		    <Private>False</Private>
		</Reference>
		<Reference Include="ProtoFlux.Nodes.FrooxEngine">
		    <HintPath>$(ResoniteRoot)ProtoFlux.Nodes.FrooxEngine.dll</HintPath>
		    <Private>False</Private>
		</Reference>
		<Reference Include="Renderite.Shared">
		    <HintPath>$(ResoniteRoot)Renderite.Shared.dll</HintPath>
		    <Private>False</Private>
		</Reference>
	</ItemGroup>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(CopyToMods)'=='true'">
		<Message Text="Attempting to copy $(TargetFileName) to $(ResoniteRoot)rml_mods" Importance="high" />
		<Copy SourceFiles="$(TargetDir)$(TargetFileName)" DestinationFolder="$(ResoniteRoot)rml_mods" />
	</Target>
</Project>
